{
  "name": "mcpicloudcalendar",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "mcpicloudcalendar": "./dist/index.js",
    "mcpicloudcalendar-http": "./dist/http.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js http",
    "check": "tsc --noEmit && vitest run && tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
